{
  "height": 35,
  "output": ["DP-1"],

  // modules display order
  "modules-left": [
    "wireplumber"
  ],
  "modules-right": [
    "tray",
    "network",
    "group/cpu-temp",
    "memory",
    "clock"
  ],

  // modules configuration
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "cpu": {
    "format": "CPU: {usage}% |",
    "tooltip": false
  },
  "memory": {
    "format": "RAM: {}%"
  },
  "network": {
    "format-wifi": "({signalStrength}%) ",
    "format-ethernet": "󰈀",
    "tooltip-format": "{ipaddr}\n<b>up:</b> {bandwidthUpBytes} <b>down:</b> {bandwidthDownBytes}",
    "format-linked": "{ifname} (No IP) ?",
    "format-disconnected": "󰖪",
    "on-click": "networkmanager_dmenu",
    "on-click-right": "$TERMINAL -a floatterm -e nethogs"
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon}: {volume}%",
    "format-muted": " ",
    "format-icons": [
      " ",
      " "
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "clock": {
    "format": "{:%a, %b %d | %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode-mon-col": 4,
      "format": {
        "months": "<span color='#D3869B'><b>{}</b></span>",
        "days": "<span color='#EBDBB2'><b>{}</b></span>",
	      "weekdays": "<span color='#83A598'><b>{}</b></span>",
        "today": "<span color='#FE8019'><b>{}</b></span>"
      }
    },
    "locale": "en_US.UTF-8",
    "actions": {
      "on-click-right": "mode"
    },
    "tooltip": true
  },
  "custom/temp": {
    "exec": "~/.config/waybar/cpu-temp.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "group/cpu-temp": {
    "orientation": "horizontal", 
    "modules": [ "cpu", "custom/temp" ]
  }
}

