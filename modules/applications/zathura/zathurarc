
set notification-error-bg "#282828" #bg0
set notification-error-fg "#fb4934" #red1
set notification-warning-bg "#282828" #bg0
set notification-warning-fg "#fabd2f" #yellow1
set notification-bg "#282828" #bg0
set notification-fg "#b8bb26" #green1

set completion-bg "#504945" #bg2
set completion-fg "#ebdbb2" #fg1
set completion-group-bg "#3c3836" #bg1
set completion-group-fg "#928374" #gray
set completion-highlight-bg "#83a598" #blue1
set completion-highlight-fg "#504945" #bg2

set index-bg "#504945" #bg2
set index-fg "#ebdbb2" #fg1
set index-active-bg "#83a598" #blue1
set index-active-fg "#504945" #bg2

set inputbar-bg "#282828" #bg0
set inputbar-fg "#ebdbb2" #fg1

set statusbar-bg "#504945" #bg2
set statusbar-fg "#ebdbb2" #fg1

set highlight-color "rgba(250,189,47,0.5)" #yellow1"
set highlight-active-color "rgba(254,128,25,0.5)" #orange1

set default-bg "#282828" #bg0
set default-fg "#ebdbb2" #fg1

set render-loading true
set render-loading-bg "#282828" #bg0
set render-loading-fg "#ebdbb2" #fg1

set recolor true
set recolor-keephue true
set recolor-lightcolor "#282828" #bg0
set recolor-darkcolor "#ebdbb2" #fg1

set font "FiraCode Nerd Font 11"

map <C-c> exec "sh -c 'wl-paste -p | wl-copy'" #copy
map <C-p> navigate previous #page up
map <C-n> navigate next #page down

